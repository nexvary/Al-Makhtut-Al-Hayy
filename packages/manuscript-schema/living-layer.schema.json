{
  "$defs": {
    "CitationTarget": {
      "properties": {
        "manuscript_id": {
          "title": "Manuscript Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        },
        "canvas_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canvas Uri"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "manuscript_id",
        "page_id"
      ],
      "title": "CitationTarget",
      "type": "object"
    },
    "LayerKind": {
      "enum": [
        "original_image",
        "machine_reading",
        "draft_transcription",
        "verified_transcription",
        "critical_text",
        "modernized_text",
        "simplified_explanation",
        "translation",
        "audio",
        "named_entities",
        "historical_objects",
        "illustrations",
        "references",
        "annotations",
        "provenance"
      ],
      "title": "LayerKind",
      "type": "string"
    },
    "LayerProvenance": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "extraction_method": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CitationTarget"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "source",
        "extraction_method"
      ],
      "title": "LayerProvenance",
      "type": "object"
    },
    "Point": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "ReviewState": {
      "enum": [
        "machine",
        "draft",
        "verified"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "SourceAnchor": {
      "properties": {
        "manuscript_id": {
          "title": "Manuscript Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        },
        "canvas_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canvas Uri"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "witness_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Witness Id"
        },
        "coordinates": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 1000,
          "title": "Coordinates",
          "type": "array"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        }
      },
      "required": [
        "manuscript_id",
        "page_id"
      ],
      "title": "SourceAnchor",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/LayerKind"
    },
    "state": {
      "$ref": "#/$defs/ReviewState",
      "default": "draft"
    },
    "language": {
      "anyOf": [
        {
          "maxLength": 35,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "asset_uri": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asset Uri"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/LayerProvenance"
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Revision Id"
    }
  },
  "required": [
    "kind",
    "provenance"
  ],
  "title": "LivingLayer",
  "type": "object"
}

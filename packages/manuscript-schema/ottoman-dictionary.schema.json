{
  "$defs": {
    "CitationTarget": {
      "properties": {
        "manuscript_id": {
          "title": "Manuscript Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        },
        "canvas_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canvas Uri"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "manuscript_id",
        "page_id"
      ],
      "title": "CitationTarget",
      "type": "object"
    },
    "LayerProvenance": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "extraction_method": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CitationTarget"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "source",
        "extraction_method"
      ],
      "title": "LayerProvenance",
      "type": "object"
    },
    "Point": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "ReviewState": {
      "enum": [
        "machine",
        "draft",
        "verified"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "SourceAnchor": {
      "properties": {
        "manuscript_id": {
          "title": "Manuscript Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        },
        "canvas_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canvas Uri"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "witness_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Witness Id"
        },
        "coordinates": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 1000,
          "title": "Coordinates",
          "type": "array"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        }
      },
      "required": [
        "manuscript_id",
        "page_id"
      ],
      "title": "SourceAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 100,
      "title": "Id",
      "type": "string"
    },
    "entry_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Entry Id",
      "type": "string"
    },
    "spelling": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Spelling",
      "type": "string"
    },
    "transliteration": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transliteration"
    },
    "modern_turkish": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Modern Turkish"
    },
    "arabic": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arabic"
    },
    "english": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "English"
    },
    "grammatical_note": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grammatical Note"
    },
    "historical_meaning": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Historical Meaning"
    },
    "linguistic_origin": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Linguistic Origin"
    },
    "related_forms": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Related Forms",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/ReviewState",
      "default": "draft"
    },
    "provenance": {
      "$ref": "#/$defs/LayerProvenance"
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Revision Id"
    }
  },
  "required": [
    "entry_id",
    "spelling",
    "provenance"
  ],
  "title": "DictionaryEntry",
  "type": "object"
}

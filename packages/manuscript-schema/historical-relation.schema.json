{
  "$defs": {
    "CitationTarget": {
      "properties": {
        "manuscript_id": {
          "title": "Manuscript Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        },
        "canvas_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canvas Uri"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "manuscript_id",
        "page_id"
      ],
      "title": "CitationTarget",
      "type": "object"
    },
    "HistoricalInterval": {
      "properties": {
        "start_year": {
          "maximum": 3000,
          "minimum": -10000,
          "title": "Start Year",
          "type": "integer"
        },
        "end_year": {
          "maximum": 3000,
          "minimum": -10000,
          "title": "End Year",
          "type": "integer"
        },
        "circa": {
          "default": false,
          "title": "Circa",
          "type": "boolean"
        },
        "calendar": {
          "default": "proleptic-gregorian",
          "title": "Calendar",
          "type": "string"
        }
      },
      "required": [
        "start_year",
        "end_year"
      ],
      "title": "HistoricalInterval",
      "type": "object"
    },
    "LayerProvenance": {
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "extraction_method": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "source_text": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Text"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/CitationTarget"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "source",
        "extraction_method"
      ],
      "title": "LayerProvenance",
      "type": "object"
    },
    "Point": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "ReviewState": {
      "enum": [
        "machine",
        "draft",
        "verified"
      ],
      "title": "ReviewState",
      "type": "string"
    },
    "SourceAnchor": {
      "properties": {
        "manuscript_id": {
          "title": "Manuscript Id",
          "type": "string"
        },
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "region_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Id"
        },
        "canvas_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canvas Uri"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "witness_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Witness Id"
        },
        "coordinates": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 1000,
          "title": "Coordinates",
          "type": "array"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        }
      },
      "required": [
        "manuscript_id",
        "page_id"
      ],
      "title": "SourceAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "state": {
      "$ref": "#/$defs/ReviewState",
      "default": "draft"
    },
    "provenance": {
      "$ref": "#/$defs/LayerProvenance"
    },
    "id": {
      "maxLength": 100,
      "title": "Id",
      "type": "string"
    },
    "relation_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Relation Id",
      "type": "string"
    },
    "subject": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "predicate": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Predicate",
      "type": "string"
    },
    "object": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Object",
      "type": "string"
    },
    "interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/HistoricalInterval"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Revision Id"
    }
  },
  "required": [
    "provenance",
    "relation_id",
    "subject",
    "predicate",
    "object"
  ],
  "title": "HistoricalRelation",
  "type": "object"
}

{
  "$defs": {
    "Page": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "folio_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Folio Label"
        },
        "image": {
          "title": "Image",
          "type": "string"
        },
        "canvas_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canvas Uri"
        },
        "image_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Width"
        },
        "image_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Height"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/Region"
          },
          "title": "Regions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "sequence",
        "image"
      ],
      "title": "Page",
      "type": "object"
    },
    "Point": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Region": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "region_type": {
          "$ref": "#/$defs/RegionType",
          "default": "text_line"
        },
        "reading_order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading Order"
        },
        "polygon": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "title": "Polygon",
          "type": "array"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/TextLayer"
          },
          "title": "Layers",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "Region",
      "type": "object"
    },
    "RegionType": {
      "enum": [
        "text_line",
        "marginalia",
        "illustration",
        "table",
        "decoration",
        "other"
      ],
      "title": "RegionType",
      "type": "string"
    },
    "TextLayer": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/TextLayerKind"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "machine",
            "draft",
            "verified"
          ],
          "title": "Status",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "kind",
        "text",
        "status"
      ],
      "title": "TextLayer",
      "type": "object"
    },
    "TextLayerKind": {
      "enum": [
        "htr_raw",
        "diplomatic_transcription",
        "verified_transcription",
        "normalized_arabic",
        "simplified_arabic",
        "translation",
        "ai_explanation"
      ],
      "title": "TextLayerKind",
      "type": "string"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "author": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author"
    },
    "date_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date Label"
    },
    "source_institution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Institution"
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "work_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Work Id"
    },
    "witness_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Witness Id"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "title": "Manuscript",
  "type": "object"
}
